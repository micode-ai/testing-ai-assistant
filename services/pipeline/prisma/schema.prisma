generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PipelineTrigger {
  PUSH
  PULL_REQUEST
  SCHEDULE
  MANUAL
}

enum TestRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERRORED
  CANCELLED
}

enum TestCheckType {
  UNIT
  INTEGRATION
  E2E
  LOAD
  LINT
  SAST
  DAST
  DEPENDENCY_AUDIT
  AI_REVIEW
  REPOSITORY_SETUP
  COVERAGE
}

enum TestStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  CANCELLED
}

model Pipeline {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  trigger   PipelineTrigger
  cronExpr  String?  @map("cron_expr")
  steps     Json     @default("[]")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  runs      TestRun[]

  @@index([projectId])
  @@map("pipelines")
}

model TestRun {
  id          String        @id @default(uuid())
  pipelineId  String        @map("pipeline_id")
  commitSha   String        @map("commit_sha")
  branch      String
  status      TestRunStatus @default(QUEUED)
  startedAt   DateTime?     @map("started_at")
  finishedAt  DateTime?     @map("finished_at")
  triggeredBy String?       @map("triggered_by")
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  pipeline    Pipeline      @relation(fields: [pipelineId], references: [id])
  results     TestResult[]

  @@index([pipelineId])
  @@index([status])
  @@map("test_runs")
}

model TestResult {
  id          String        @id @default(uuid())
  runId       String        @map("run_id")
  checkType   TestCheckType @map("check_type")
  status      TestStatus    @default(PENDING)
  summary     String        @default("")
  details     Json          @default("{}")
  artifactUrl String?       @map("artifact_url")
  durationMs  Int           @default(0) @map("duration_ms")
  createdAt   DateTime      @default(now()) @map("created_at")
  run         TestRun       @relation(fields: [runId], references: [id])
  coverage    CoverageSnapshot?

  @@index([runId])
  @@map("test_results")
}

enum ChecklistItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Checklist {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String   @default("")
  targetUrl   String?  @map("target_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  items       ChecklistItem[]
  runs        ChecklistRun[]

  @@index([projectId])
  @@map("checklists")
}

model ChecklistItem {
  id                String                @id @default(uuid())
  checklistId       String                @map("checklist_id")
  title             String
  description       String                @default("")
  expectedBehavior  String                @default("") @map("expected_behavior")
  priority          ChecklistItemPriority @default(MEDIUM)
  order             Int                   @default(0)
  generatedTestCode String?               @map("generated_test_code") @db.Text
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  checklist         Checklist             @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  results           ChecklistItemResult[]

  @@index([checklistId])
  @@map("checklist_items")
}

model ChecklistRun {
  id          String        @id @default(uuid())
  checklistId String        @map("checklist_id")
  targetUrl   String        @map("target_url")
  status      TestRunStatus @default(QUEUED)
  triggeredBy String?       @map("triggered_by")
  startedAt   DateTime?     @map("started_at")
  finishedAt  DateTime?     @map("finished_at")
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at")
  checklist   Checklist     @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemResults ChecklistItemResult[]

  @@index([checklistId])
  @@index([status])
  @@map("checklist_runs")
}

model ChecklistItemResult {
  id          String     @id @default(uuid())
  runId       String     @map("run_id")
  itemId      String     @map("item_id")
  status      TestStatus @default(PENDING)
  summary     String     @default("")
  details     Json       @default("{}")
  screenshots Json       @default("[]")
  durationMs  Int        @default(0) @map("duration_ms")
  createdAt   DateTime   @default(now()) @map("created_at")
  run         ChecklistRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  item        ChecklistItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([itemId])
  @@map("checklist_item_results")
}

model CoverageSnapshot {
  id          String     @id @default(uuid())
  resultId    String     @unique @map("result_id")
  linePct     Float      @map("line_pct")
  branchPct   Float      @map("branch_pct")
  functionPct Float      @map("function_pct")
  uncovered   Json       @default("{}")
  result      TestResult @relation(fields: [resultId], references: [id])

  @@map("coverage_snapshots")
}
