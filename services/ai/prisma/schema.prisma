generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum GenerationType {
  TEST_GEN
  BUG_DETECT
  FLAKY_DETECT
  COVERAGE_ADVICE
  CHECKLIST_GEN
  CHECKLIST_TEST_GEN
  PROJECT_ANALYSIS
  TEST_PROPOSAL
}

enum TestGenSessionStatus {
  ANALYZING
  PROPOSING
  AWAITING_APPROVAL
  GENERATING
  REVIEW
  COMMITTING
  COMMITTED
  FAILED
}

model AIGeneration {
  id           String         @id @default(uuid())
  projectId    String         @map("project_id")
  type         GenerationType
  inputContext Json           @map("input_context")
  output       String         @db.Text
  model        String
  tokensUsed   Int            @default(0) @map("tokens_used")
  accepted     Boolean?
  feedback     String?
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([projectId])
  @@index([type])
  @@map("ai_generations")
}

model ProjectProfile {
  id             String   @id @default(uuid())
  projectId      String   @unique @map("project_id")
  language       String
  testFramework  String   @map("test_framework")
  packageManager String?  @map("package_manager")
  structure      Json // file tree summary, key directories
  testPatterns   Json?    @map("test_patterns") // existing test file patterns
  dependencies   Json? // key dependencies
  analyzedAt     DateTime @map("analyzed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_profiles")
}

model TestGenSession {
  id              String               @id @default(uuid())
  projectId       String               @map("project_id")
  status          TestGenSessionStatus
  profileId       String?              @map("profile_id")
  proposal        Json? // proposed tests
  approvedItems   Json?                @map("approved_items") // user-approved subset
  generatedTests  Json?                @map("generated_tests") // { path, content }[]
  branchName      String?              @map("branch_name")
  commitSha       String?              @map("commit_sha")
  commitUrl       String?              @map("commit_url")
  pullRequestUrl  String?              @map("pull_request_url")
  totalTokensUsed Int                  @default(0) @map("total_tokens_used")
  metadata        Json?                // progress info, etc.
  error           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("test_gen_sessions")
}

model Conversation {
  id        String        @id @default(uuid())
  projectId String        @map("project_id")
  title     String        @default("")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]

  @@index([projectId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  role           String // "user" | "assistant" | "tool"
  content        String       @db.Text
  toolCalls      Json?        @map("tool_calls")
  toolResults    Json?        @map("tool_results")
  model          String?
  tokensUsed     Int          @default(0) @map("tokens_used")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

model KnowledgeChunk {
  id        String                 @id @default(uuid())
  projectId String?                @map("project_id")
  source    String
  content   String                 @db.Text
  embedding Unsupported("vector")?
  metadata  Json                   @default("{}")
  createdAt DateTime               @default(now()) @map("created_at")

  @@index([projectId])
  @@map("knowledge_chunks")
}
