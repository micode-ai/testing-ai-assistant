{
  "name": "@testing-ai/test-runner",
  "version": "0.1.0",
  "description": "Temporal worker service for orchestrating test execution pipelines",
  "private": true,
  "main": "dist/worker.js",
  "scripts": {
    "build": "tsc && npm run build:workflow-bundle",
    "build:workflow-bundle": "ts-node src/scripts/build-workflow-bundle.ts",
    "dev": "ts-node src/worker.ts",
    "start": "node dist/worker.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "@testing-ai/shared-types": "workspace:*",
    "@testing-ai/shared-utils": "workspace:*",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "minio": "^8.0.0"
  },
  "devDependencies": {
    "@testing-ai/config": "workspace:^",
    "@types/node": "^20.11.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
